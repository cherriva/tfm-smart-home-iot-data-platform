# Copia este archivo como .env y completa la contraseña MQTT.
MQTT_HOST=gallodomotica.duckdns.org
MQTT_PORT=8883
MQTT_USERNAME=mqtt
MQTT_PASSWORD=CAMBIAR_AQUI
MQTT_TOPIC=tfm/+/events/#
MQTT_TLS=true
MQTT_TLS_INSECURE=false

# El ingestor usa el nombre del servicio dentro de Docker.
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=tfm.matter.events
MQTT_CLIENT_ID=tfm-mqtt-ingestor

# Dataset de demostración. Se publica directamente en Redpanda y nunca modifica Home Assistant.
SYNTHETIC_ENABLED=true
SYNTHETIC_DATASET_ID=tfm-demo-v1
SYNTHETIC_ENTITY_PREFIX=synthetic_
SYNTHETIC_SEED=20260913
SYNTHETIC_BOOTSTRAP_HOURS=960
SYNTHETIC_BOOTSTRAP_STEP_SECONDS=900
SYNTHETIC_INTERVAL_SECONDS=300
SYNTHETIC_INCLUDE_REGISTRY_ONLY=false

MINIO_ENDPOINT=minio:9000
# Valores locales de desarrollo; cámbialos si el stack se expone fuera de tu equipo.
MINIO_ROOT_USER=tfm_admin
MINIO_ROOT_PASSWORD=tfm_dev_password_change_me
# Grafana local. Si no se modifican, el acceso es admin/admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Lakehouse Iceberg
KAFKA_LOG_ID=tfm-log-v1
LAKEHOUSE_CHECKPOINT_PATH=s3a://tfm-checkpoints/iceberg_v1
LAKEHOUSE_MAX_OFFSETS_PER_TRIGGER=5000
LAKEHOUSE_TRIGGER_INTERVAL=30 seconds
QUALITY_TEMPERATURE_MIN_C=-40
QUALITY_TEMPERATURE_MAX_C=85
QUALITY_FUTURE_TOLERANCE_SECONDS=300
QUALITY_LATE_THRESHOLD_SECONDS=86400
QUALITY_INACTIVITY_SECONDS=86400
# Los históricos se admiten con quality_warnings=['late_event'].

# Batch AEMET / Airflow (secretos únicamente en .env)
AEMET_API_KEY=
AEMET_LAG_DAYS=4
AEMET_BRONZE_BUCKET=tfm-bronze
AEMET_SILVER_BUCKET=tfm-lakehouse
AEMET_STATION_ID=9263D
# Batch Datadis / Airflow (secretos únicamente en .env)
DATADIS_USERNAME=
DATADIS_PASSWORD=
DATADIS_LOOKBACK_MONTHS=3
DATADIS_REQUEST_DELAY_SECONDS=65
DATADIS_BRONZE_BUCKET=tfm-bronze
DATADIS_S3_ENDPOINT=http://localhost:9000
AIRFLOW_DB_PASSWORD=airflow_local_dev
AIRFLOW_API_SECRET=local-development-change-me
