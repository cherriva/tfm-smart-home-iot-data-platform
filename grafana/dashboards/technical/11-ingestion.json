    {
      "id": 11,
      "type": "barchart",
      "title": "Volumen actual por capa",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT layer, CAST(records AS double) AS records FROM (SELECT 'Bronze' layer,bronze_records records FROM tfm.iot_gold.ingestion_summary UNION ALL SELECT 'Silver',silver_records FROM tfm.iot_gold.ingestion_summary UNION ALL SELECT 'Gold',gold_records FROM tfm.iot_gold.ingestion_summary UNION ALL SELECT 'Cuarentena',quarantine_records FROM tfm.iot_gold.ingestion_summary) ORDER BY records DESC",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Registros procesados por hora y capa",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT time,layer metric,CAST(records AS double) value FROM tfm.iot_gold.ingestion_hourly WHERE $__timeFilter(time) ORDER BY 1,2",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
