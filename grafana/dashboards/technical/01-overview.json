    {
      "id": 8,
      "type": "table",
      "title": "Estado de las capas",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT 'Bronze' AS layer, count(*) AS rows, max(bronze_timestamp) AS latest FROM tfm.bronze.matter_events UNION ALL SELECT 'Silver', count(*), max(ingestion_time) FROM tfm.silver.matter_events UNION ALL SELECT 'Gold', count(*), max(last_event_time) FROM tfm.gold.entity_5m ORDER BY layer",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
