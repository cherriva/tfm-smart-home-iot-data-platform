          "refId": "A",
          "rawSQL": "SELECT event_time, ingestion_time, domain, coalesce(element_at(attributes, 'original_entity_id'), entity_id) AS entity_id, state, numeric_state, unit, quality_flag, replace(coalesce(friendly_name, entity_id), '[SYN] ', '') AS friendly_name FROM tfm.silver.matter_events ORDER BY event_time DESC LIMIT 50",
