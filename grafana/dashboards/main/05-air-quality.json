{
  "uid": "tfm-air-quality",
  "title": "🌬 Calidad del Aire y Ventilación",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-40d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CO₂ medio casa",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT avg(co2_ppm) value FROM tfm.iot_gold.air_quality_hourly WHERE $__timeFilter(time)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Peor CO₂ actual",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT max(co2_ppm) value FROM tfm.iot_gold.air_quality_hourly WHERE time=(SELECT max(time) FROM tfm.iot_gold.air_quality_hourly WHERE co2_ppm IS NOT NULL)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Máximo CO₂",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT max(co2_ppm) value FROM tfm.iot_gold.air_quality_hourly WHERE $__timeFilter(time)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Horas sobre umbral",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT count_if(co2_over_threshold) value FROM tfm.iot_gold.air_quality_hourly WHERE $__timeFilter(time)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Habitación peor ventilada",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT room, round(avg(co2_ppm), 1) AS co2_medio_ppm FROM tfm.iot_gold.air_quality_hourly WHERE $__timeFilter(time) GROUP BY room ORDER BY co2_medio_ppm DESC LIMIT 1",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CO₂ por habitación",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT time, room metric, co2_ppm value FROM tfm.iot_gold.air_quality_hourly WHERE $__timeFilter(time) ORDER BY 1,2",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Calidad del aire por habitación",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT room, CAST(avg(healthy_air_score) AS double) AS healthy_air_pct FROM tfm.iot_gold.air_quality_hourly WHERE $__timeFilter(time) GROUP BY room ORDER BY 2",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CO₂ y ocupación",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT a.time, a.room metric, a.co2_ppm value FROM tfm.iot_gold.air_quality_hourly a WHERE $__timeFilter(a.time) ORDER BY 1,2",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Humedad por habitación",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT time, room metric, humidity_pct value FROM tfm.iot_gold.air_quality_hourly WHERE $__timeFilter(time) ORDER BY 1,2",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    }
  ]
}
