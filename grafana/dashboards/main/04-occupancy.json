{
  "uid": "tfm-occupancy",
  "title": "👤 Ocupación y Uso de Espacios",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-40d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tiempo ocupado",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT coalesce(CAST(sum(occupied_minutes) AS double)/60, 0.0) AS value FROM tfm.iot_gold.occupancy_hourly WHERE $__timeFilter(time)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Habitación más utilizada",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT room, CAST(sum(occupied_minutes) AS double)/60 AS occupied_hours FROM tfm.iot_gold.occupancy_hourly WHERE $__timeFilter(time) GROUP BY room ORDER BY occupied_hours DESC LIMIT 1",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Luz sin presencia",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT coalesce(CAST(sum(light_without_presence_minutes) AS double)/60, 0.0) AS value FROM tfm.iot_gold.occupancy_hourly WHERE $__timeFilter(time)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Eficiencia de iluminación",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT coalesce(100*(1-CAST(sum(light_without_presence_minutes) AS double)/nullif(CAST(sum(light_on_minutes) AS double),0)), 0.0) AS value FROM tfm.iot_gold.occupancy_hourly WHERE $__timeFilter(time)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Ocupación por estancia",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT room, CAST(sum(occupied_minutes) AS double)/60 AS occupied_hours FROM tfm.iot_gold.occupancy_hourly WHERE $__timeFilter(time) GROUP BY room ORDER BY 2 DESC",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Timeline de presencia",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT time, room metric, CASE WHEN occupied THEN 1 ELSE 0 END value FROM tfm.iot_gold.occupancy_hourly WHERE $__timeFilter(time) ORDER BY 1,2",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Uso por hora",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT time, room metric, CAST(occupied_minutes AS double) value FROM tfm.iot_gold.occupancy_hourly WHERE $__timeFilter(time) ORDER BY 1,2",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Uso de iluminación",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT room, CAST(sum(light_on_minutes) AS double)/60 AS light_on_hours, CAST(sum(light_without_presence_minutes) AS double)/60 AS without_presence_hours FROM tfm.iot_gold.occupancy_hourly WHERE $__timeFilter(time) GROUP BY room ORDER BY 2 DESC",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    }
  ]
}
