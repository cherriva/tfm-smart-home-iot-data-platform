    {
      "id": 7,
      "type": "table",
      "title": "Resumen estadístico por sensor",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT room_name AS estancia, round(avg(indoor_mean_temperature_c), 2) AS temperatura_media, round(avg(indoor_mean_humidity_pct), 2) AS humedad_media, sum(indoor_event_count) AS eventos, max(last_indoor_event_time) AS ultima_lectura FROM tfm.gold.environment_daily WHERE $__timeFilter(observation_date) GROUP BY room_name ORDER BY estancia",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Lecturas por sensor",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 14
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT coalesce(element_at(attributes, 'original_entity_id'), entity_id) AS metric, CAST(count(*) AS DOUBLE) AS value FROM tfm.silver.matter_events WHERE domain = 'sensor' AND numeric_state IS NOT NULL AND $__timeFilter(event_time) GROUP BY 1 ORDER BY value DESC LIMIT 20",
          "format": 1
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "metric",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "value",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Último valor conocido por sensor",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "WITH latest AS (SELECT coalesce(element_at(attributes, 'original_entity_id'), entity_id) AS entity_id, replace(coalesce(friendly_name, entity_id), '[SYN] ', '') AS friendly_name, numeric_state AS value, unit, quality_flag AS quality, event_time AS last_event, row_number() OVER (PARTITION BY coalesce(element_at(attributes, 'original_entity_id'), entity_id) ORDER BY event_time DESC, bronze_timestamp DESC) AS rn FROM tfm.silver.matter_events WHERE domain = 'sensor') SELECT entity_id, friendly_name, value, unit, quality, last_event FROM latest WHERE rn = 1 ORDER BY last_event DESC",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
