        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Estado de los sensores ambientales",
      "description": "Una fila por sensor ambiental principal integrado en la canalización.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "WITH latest AS (SELECT max(observation_date) AS d FROM tfm.gold.environment_daily) SELECT room_name AS estancia, 'Temperatura' AS medida, CAST(indoor_mean_temperature_c AS DOUBLE) AS valor, CAST(temperature_event_count AS BIGINT) AS eventos, CASE WHEN temperature_event_count > 0 THEN 'OK' ELSE 'SIN DATOS' END AS calidad, last_indoor_event_time AS ultima_actualizacion FROM tfm.gold.environment_daily CROSS JOIN latest WHERE observation_date = latest.d AND indoor_mean_temperature_c IS NOT NULL UNION ALL SELECT room_name AS estancia, 'Humedad' AS medida, CAST(indoor_mean_humidity_pct AS DOUBLE) AS valor, CAST(humidity_event_count AS BIGINT) AS eventos, CASE WHEN humidity_event_count > 0 THEN 'OK' ELSE 'SIN DATOS' END AS calidad, last_indoor_event_time AS ultima_actualizacion FROM tfm.gold.environment_daily CROSS JOIN latest WHERE observation_date = latest.d AND indoor_mean_humidity_pct IS NOT NULL ORDER BY estancia, medida",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "calidad"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "unavailable": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
