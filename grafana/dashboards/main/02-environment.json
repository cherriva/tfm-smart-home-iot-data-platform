      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT CAST(observation_date AS timestamp) AS time, room_name AS metric, indoor_mean_temperature_c AS value FROM tfm.gold.environment_daily WHERE indoor_mean_temperature_c IS NOT NULL AND $__timeFilter(observation_date) ORDER BY 1, 2",
