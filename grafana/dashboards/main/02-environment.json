      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT room_name AS metric, CAST(indoor_mean_temperature_c AS DOUBLE) AS value FROM tfm.gold.environment_daily WHERE observation_date = (SELECT max(observation_date) FROM tfm.gold.environment_daily) AND indoor_mean_temperature_c IS NOT NULL ORDER BY metric",
          "format": 1
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "metric",
                "handlerKey": "field.name"
              },
