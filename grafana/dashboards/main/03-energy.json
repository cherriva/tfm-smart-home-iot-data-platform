{
  "uid": "tfm-energy",
  "title": "⚡ Energía y Coste",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Energía real hoy · Datadis",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT coalesce(sum(grid_energy_kwh),0) value FROM tfm.iot_gold.energy_daily WHERE day=current_date",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kWh"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Energía real este mes · Datadis",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT coalesce(sum(grid_energy_kwh),0) value FROM tfm.iot_gold.energy_daily WHERE date_trunc('month',day)=date_trunc('month',current_date)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kWh"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Coste hoy",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT coalesce(sum(estimated_cost_eur),0) value FROM tfm.iot_gold.energy_daily WHERE day=current_date",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Coste este mes",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT coalesce(sum(estimated_cost_eur),0) value FROM tfm.iot_gold.energy_daily WHERE date_trunc('month',day)=date_trunc('month',current_date)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Potencia estimada actual",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT sum(avg_power_kw) value FROM tfm.iot_gold.energy_hourly WHERE time=(SELECT max(time) FROM tfm.iot_gold.energy_hourly)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kW"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Pico de potencia",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT max(peak_power_kw) value FROM tfm.iot_gold.energy_daily WHERE $__timeFilter(CAST(day AS timestamp))",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kW"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Consumo base",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT avg(baseline_power_kw)*1000 value FROM tfm.iot_gold.energy_daily WHERE $__timeFilter(CAST(day AS timestamp))",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Última ingesta Datadis",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT coalesce(CAST(max(day) FILTER (WHERE grid_energy_kwh IS NOT NULL) AS varchar),'Sin ingesta') value FROM tfm.iot_gold.energy_daily",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Perfil de potencia",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT time, source metric, sum(avg_power_kw) value FROM tfm.iot_gold.energy_hourly WHERE $__timeFilter(time) GROUP BY 1,2 ORDER BY 1,2",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kW"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Consumo diario",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT day, coalesce(max(grid_energy_kwh),sum(estimated_energy_kwh)) energy_kwh FROM tfm.iot_gold.energy_daily WHERE $__timeFilter(CAST(day AS timestamp)) GROUP BY day ORDER BY day",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kWh"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Distribución estimada por estancia",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT room, sum(estimated_energy_kwh) energy_kwh FROM tfm.iot_gold.energy_room_daily WHERE $__timeFilter(CAST(day AS timestamp)) GROUP BY room ORDER BY 2 DESC",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kWh"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "heatmap",
      "title": "Consumo por hora del día",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "tfm-trino"
      },
      "targets": [
        {
          "refId": "A",
          "rawSQL": "SELECT time, CAST(hour(time) AS varchar) metric, sum(energy_kwh) value FROM tfm.iot_gold.energy_hourly WHERE $__timeFilter(time) GROUP BY 1,2 ORDER BY 1",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kWh"
        },
        "overrides": []
      }
    }
  ]
}
